{
  "name": "kefel-bekef",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "images": "node scripts/optimize-images.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/heebo": "5.3.0",
    "dexie": "4.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.1.3",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-window": "7.4.1"
  }
}
